# Render backend service environment reference. Replace every placeholder.
# For the existing app, use the generated .render-upgrade.env and RENDER_UPGRADE.md.
# This reference also supports a fresh installation. Never baseline the source schema.
SPRING_PROFILES_ACTIVE=couples,couples-production

# PostgreSQL: runtime role with DML access; separate migration role with DDL access.
# Provision role permissions before startup. Neither role should be a superuser.
COUPLES_DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DATABASE?sslmode=require
COUPLES_DB_USERNAME=app_runtime
COUPLES_DB_PASSWORD=YOUR_RUNTIME_PASSWORD
COUPLES_MIGRATION_USERNAME=app_migrations
COUPLES_MIGRATION_PASSWORD=YOUR_MIGRATION_PASSWORD
COUPLES_DB_SCHEMA=couples_app
# Existing DB_*, JWT_SECRET, R2_* and FIREBASE_SERVICE_ACCOUNT_PATH values are
# fallbacks; they do not need duplicate COUPLES_* values unless being overridden.
# Migration credentials default to the existing DB_USERNAME/DB_PASSWORD.

# Generate two different random secrets, each at least 32 characters.
COUPLES_JWT_SECRET=REPLACE_WITH_A_RANDOM_JWT_SIGNING_SECRET
COUPLES_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_ACTION_TOKEN_SECRET

# Public frontend origin; email verification/reset/invitation links use this URL.
COUPLES_PUBLIC_URL=https://YOUR_FRONTEND_DOMAIN
COUPLES_SUPPORT_EMAIL=support@YOUR_DOMAIN
# Choose 1–90 days to match the published policy.
COUPLES_CLOSED_RETENTION_DAYS=30
# Registration is disabled by default. Enable after deployment checks pass.
COUPLES_REGISTRATION_ENABLED=false
COUPLES_EMAIL_ENABLED=false
# Explicitly approved existing accounts while email delivery is disabled.
COUPLES_PRIVATE_ACCOUNT_EMAILS=OWNER_EMAIL,RECIPIENT_EMAIL

# Optional at official launch: enable email and configure your chosen provider.
# COUPLES_SMTP_HOST=YOUR_SMTP_HOST
# COUPLES_SMTP_PORT=YOUR_SMTP_PORT
# COUPLES_SMTP_USERNAME=YOUR_SMTP_USERNAME
# COUPLES_SMTP_PASSWORD=YOUR_SMTP_PASSWORD
# COUPLES_SMTP_AUTH=true
# COUPLES_SMTP_STARTTLS=true
# COUPLES_SMTP_SSL=false
# COUPLES_MAIL_FROM=YOUR_VERIFIED_SENDER

# Private Cloudflare R2 bucket and credentials scoped to that bucket.
COUPLES_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
COUPLES_R2_BUCKET=YOUR_PRIVATE_BUCKET
COUPLES_R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
COUPLES_R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Path to the server-side Firebase service account file supplied as a secret file.
COUPLES_FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
# Hosted web origin plus the actual native origin. Android defaults to https://localhost.
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN,https://localhost

# One-time personal import. Leave false for a fresh installation.
# Requires a separate target schema and a frozen source (see RENDER_UPGRADE.md).
COUPLES_IMPORT_PERSONAL=false
COUPLES_IMPORT_SOURCE_SCHEMA=public
COUPLES_IMPORT_OWNER_EMAIL=
COUPLES_IMPORT_RECIPIENT_EMAIL=
COUPLES_IMPORT_SHARED_AUTHOR=OWNER
COUPLES_IMPORT_TIME_ZONE=Africa/Casablanca

# Frontend build environment (set these where the web/Android bundle is built):
# VITE_API_URL=https://YOUR_BACKEND_DOMAIN
# VITE_APP_LINK_ORIGIN=https://YOUR_FRONTEND_DOMAIN
# Never put backend credentials in VITE_* variables.
