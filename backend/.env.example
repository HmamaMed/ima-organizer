# Life Organizer — backend environment (example / reference)
# Copy to .env (or set these as env vars in your shell / deploy platform).
# For a hosted Postgres (e.g. Neon.tech), use the connection string they give you.

# --- Database (hosted / production) ---
# Neon gives you a URL like: postgresql://user:password@ep-xxx.region.aws.neon.tech/lifeorganizer?sslmode=require
DB_URL=jdbc:postgresql://YOUR_HOST:5432/lifeorganizer?sslmode=require
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# --- JWT ---
# Generate a strong secret:  openssl rand -base64 48
JWT_SECRET=YOUR_BASE64_SECRET
JWT_EXPIRATION_MS=604800000

# --- Seeded users (created on first startup) ---
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=owner-password
SEED_RECIPIENT_USERNAME=recipient
SEED_RECIPIENT_PASSWORD=recipient-password

# --- Firebase Admin SDK (for push notifications) ---
# Path to the service account JSON you downloaded from Firebase Console.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
